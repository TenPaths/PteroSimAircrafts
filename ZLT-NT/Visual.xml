<?xml version="1.0"?>
<!-- Metres and degrees from the centre of mass: X forward, Y right, Z up.  The
     model states everything else against its structural origin, the mooring cone
     at the bow; the loaded CG sits 34.37 m aft of it and 3.88 m below it, which
     is what the simulator reports and what the hull GLB is baked about.
     The six moving parts were cut out of that hull rather than modelled again, so
     each one still meets it along the seam it was cut on, and each GLB is baked
     about its own hinge -- which is why every xyz below is zero. -->
<visual>
  <fixture file="meshes/zlt_nt_airframe.glb" xyz="0 0 0" rpy="0 0 0"/>

  <!-- The tail is an inverted Y: one fin up, two down at 115 degrees, hinged at the
       station where the mesh doubles, 29.9 m aft of the CG. The upper one steers,
       the lower pair carries the elevator, which is how a Y tail works. The FCS
       travel is 20 degrees each way. -->
  <!-- Axis down, not up: the core reports the rudder as -dr, and JSBSim's +dr is trailing edge
       left, so about +Z a right pedal swung the trailing edge left. Same reason the converter
       points every rudder's axis down. -->
  <surface file="meshes/zlt_nt_rudder_upper.glb" xyz="0 0 0" rpy="0 0 0" source="rudder" axis="0 0 -1" hinge="-29.90 0 11.93" limit="20"/>
  <!-- The lower pair share one sign: a rotation is a pseudo-vector, so the starboard axis is the port
       one negated rather than mirrored -- mirrored, the same elevator sent one trailing edge up and
       the other down. Both now go down together on a positive elevator, as the FCS means it. -->
  <surface file="meshes/zlt_nt_rudder_port.glb" xyz="0 0 0" rpy="0 0 0" source="elevator" axis="0 -0.906 -0.423" hinge="-29.90 -7.30 0.48" limit="20"/>
  <surface file="meshes/zlt_nt_rudder_stbd.glb" xyz="0 0 0" rpy="0 0 0" source="elevator" axis="0 -0.906 0.423" hinge="-29.90 7.30 0.48" limit="20"/>

  <!-- Vectored thrust: the housings swivel with the engines they carry, so they are
       hinged where JSBSim swings the thrust and the blades ride on them. The side
       pair reaches 120 degrees, the aft one 90. -->
  <surface file="meshes/zlt_nt_nacelle_port.glb" xyz="0 0 0" rpy="0 0 0" source="tilt:motor 0" axis="0 1 0" hinge="7.86 -8.53 0.384" limit="120"/>
  <surface file="meshes/zlt_nt_nacelle_stbd.glb" xyz="0 0 0" rpy="0 0 0" source="tilt:motor 1" axis="0 1 0" hinge="7.86 8.53 0.384" limit="120"/>
  <!-- The tail cone is fixed, as the ship's is; only the spinner the propeller sits on swivels,
       about its own base 40.53 m aft of the CG -- which is where the propeller sits too. -->
  <surface file="meshes/zlt_nt_nacelle_aft.glb" xyz="0 0 0" rpy="0 0 0" source="tilt:motor 2" axis="0 1 0" hinge="-40.53 0 3.88" limit="90"/>

  <propeller file="meshes/left_propeller.glb" xyz="0 0 0" rpy="0 90 0" motor="motor 0" axis="1 0 0"/>
  <propeller file="meshes/right_propeller.glb" xyz="0 0 0" rpy="0 90 0" motor="motor 1" axis="1 0 0"/>
  <propeller file="meshes/aft_main_propeller.glb" xyz="0 0 0" rpy="0 90 0" motor="motor 2" axis="1 0 0"/>
  <propeller file="meshes/aft_aux_propeller.glb" xyz="0 0 0" rpy="-90 0 0" motor="motor 3" axis="0 1 0"/>
  <chase xyz="0 0 0" rpy="0 -15 0" length="60"/>

</visual>
