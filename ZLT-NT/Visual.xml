<?xml version="1.0"?>
<!-- Metres and degrees from the centre of mass: X forward, Y right, Z up.  The
     model states everything else against its structural origin, the mooring cone
     at the bow; the loaded CG sits 34.37 m aft of it and 3.88 m below it, which
     is what the simulator reports and what the hull GLB is baked about.
     No <surface> here: the hull mesh already carries all three fins, and a second
     copy of them hinged on top is what this file used to add.  Splitting the
     movable rudders out of the hull is what would bring deflection back. -->
<visual>
  <fixture file="meshes/zlt_nt_airframe.glb" xyz="0 0 0" rpy="0 0 0"/>
  <propeller file="meshes/left_propeller.glb" xyz="0 0 0" rpy="0 0 0" motor="motor 0" axis="1 0 0"/>
  <propeller file="meshes/right_propeller.glb" xyz="0 0 0" rpy="0 0 0" motor="motor 1" axis="1 0 0"/>
  <propeller file="meshes/aft_main_propeller.glb" xyz="0 0 0" rpy="0 0 0" motor="motor 2" axis="1 0 0"/>
  <propeller file="meshes/aft_aux_propeller.glb" xyz="0 0 0" rpy="0 0 0" motor="motor 3" axis="0 1 0"/>
</visual>
